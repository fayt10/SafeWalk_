<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F0F3FA">

    <!-- ── DARK NAVY HEADER ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#0D1B3E"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="36dp"
        android:paddingBottom="28dp">

        <!-- Back + title row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="10dp">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_arrow_back"
                android:background="@drawable/bg_icon_circle_blue"
                android:padding="8dp"
                android:layout_marginEnd="14dp"
                android:clickable="true"
                android:focusable="true"
                app:tint="#7AAED4"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SAFEWALK"
                    android:textColor="#4D9FFF"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.14"
                    android:fontFamily="monospace"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="My Guardians"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:layout_marginTop="2dp"/>

            </LinearLayout>

            <!-- Add guardian FAB-style button -->
            <ImageView
                android:id="@+id/btnAddGuardian"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_add"
                android:background="@drawable/bg_icon_circle_blue"
                android:padding="10dp"
                android:clickable="true"
                android:focusable="true"
                app:tint="#7AAED4"/>

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="People who will be alerted during your walks"
            android:textColor="#80A0C0"
            android:textSize="13sp"
            android:layout_marginStart="50dp"/>

    </LinearLayout>

    <!-- ── CONTENT AREA ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@drawable/bg_content_area"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="20dp"
        android:paddingBottom="24dp"
        android:layout_marginTop="-16dp">

        <!-- Section label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ACTIVE GUARDIANS"
            android:textColor="#8A9ABF"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.12"
            android:fontFamily="monospace"
            android:layout_marginBottom="10dp"/>

        <!-- Guardian list -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvGuardians"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="16dp"/>

        <!-- Empty state (shown when no guardians) -->
        <LinearLayout
            android:id="@+id/layoutEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="40dp"
            android:paddingBottom="40dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/ic_people"
                android:layout_marginBottom="14dp"
                app:tint="#C5CAEF"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No guardians yet"
                android:textColor="#1A237E"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Add trusted people who will receive alerts\nwhen you start or need help on a walk."
                android:textColor="#8A9ABF"
                android:textSize="13sp"
                android:gravity="center"/>

        </LinearLayout>

        <!-- Add Guardian Button -->
        <Button
            android:id="@+id/btnAddNew"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Add Guardian"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:backgroundTint="#1A237E"
            android:drawableStart="@drawable/ic_add"
            android:drawablePadding="10dp"
            android:layout_marginTop="12dp"
            app:cornerRadius="16dp"/>

    </LinearLayout>

</LinearLayout>